# Kopieer naar .env en vul in. Dit bestand NOOIT in git zetten.
NODE_ENV=production

# Domein van de boekingsserver (DNS A-record naar het IP van de server)
BOOKING_DOMAIN=boeken.innvenlo.nl
PUBLIC_API_URL=https://boeken.innvenlo.nl
# Adres van de website (GitHub Pages)
PUBLIC_SITE_URL=https://www.innvenlo.nl
CORS_ORIGINS=https://www.innvenlo.nl,https://innvenlo.nl

# Lang willekeurig wachtwoord voor de database (bv. `openssl rand -hex 24`)
POSTGRES_PASSWORD=
# Lang willekeurig geheim (min. 32 tekens, bv. `openssl rand -hex 32`)
APP_SECRET=

# E-mail via SMTP (uw eigen mailprovider of een verzenddienst)
SMTP_HOST=
SMTP_PORT=587
# true bij poort 465 (SSL), false bij 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="InnVenlo Apartments <jamb.lamberts@ziggo.nl>"
MAIL_REPLY_TO=jamb.lamberts@ziggo.nl

# Back-ups: aantal dagen bewaren
BACKUP_KEEP_DAYS=30
